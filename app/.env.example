# Copy to .env.local. EVERYTHING here is public (NEXT_PUBLIC_ is inlined into
# the browser bundle). Never put secrets, private keys or paid RPC keys here.

# localnet (default) | devnet. mainnet/mainnet-beta is rejected at startup.
NEXT_PUBLIC_SOLANA_CLUSTER=localnet

# Optional. Must be one of the selected cluster's allowed endpoints
# (localnet: http://127.0.0.1:8899 or http://localhost:8899;
#  devnet: https://api.devnet.solana.com). Leave empty for the default.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Show tax + raffle launch types as "Coming soon" (display only; no builders exist).
NEXT_PUBLIC_FF_TAX_RAFFLE=
