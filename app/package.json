{
  "name": "launchpad-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:devnet": "vitest run --config vitest.devnet.config.mts",
    "tokens": "node scripts/build-tokens.mjs",
    "gen:idl": "node scripts/gen-idl-meta.mjs",
    "icons": "node scripts/build-icons.mjs",
    "check:headings": "node scripts/check-headings.mjs"
  },
  "dependencies": {
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@solana/wallet-adapter-base": "0.9.28",
    "@solana/wallet-adapter-phantom": "0.9.30",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/wallet-adapter-react-ui": "0.9.40",
    "@solana/wallet-adapter-solflare": "0.6.34",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.5",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bn.js": "5.2.0",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
